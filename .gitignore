# =====================================================================
# ghsync-gui / kintersync  —  .gitignore
# Python 3.10+, CustomTkinter GUI, PyInstaller (--onedir) on Windows
# =====================================================================

# ---------------------------------------------------------------------
# Byte-compiled / optimized / interpreter artifacts
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.python-version

# ---------------------------------------------------------------------
# Distribution / packaging / build metadata
# ---------------------------------------------------------------------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
share/python-wheels/
parts/
var/
*.egg-info/
*.egg
.installed.cfg
MANIFEST
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------------
# PyInstaller output (generated by build.bat)
# ---------------------------------------------------------------------
*.spec
*.manifest
*.exe.bak
# PyInstaller bootloader / cache
*.pyc.cache

# ---------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/
virtualenv/

# ---------------------------------------------------------------------
# Testing / type-checking / linting caches
# ---------------------------------------------------------------------
.pytest_cache/
.cache/
coverage.xml
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
.pyright/
.ruff_cache/
.pylint.d/
pylint-results-*.txt

# ---------------------------------------------------------------------
# Local app config and secrets
# ---------------------------------------------------------------------
# The app stores its PAT in %USERPROFILE%\.ghsync-gui\config.json.
# Never commit a config file or token into the repository.
.env
.env.*
!.env.example
*.token
*.pem
*.key
.ghsync-gui/
config.json

# ---------------------------------------------------------------------
# Local mirror / backup output
# ---------------------------------------------------------------------
# If you point the app's storage path inside this repo, ignore it here.
# backup/
# mirrors/

# ---------------------------------------------------------------------
# Logs / temporary / crash dumps
# ---------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~
*.stackdump
core
crash.log

# ---------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
.spyderproject
.spyproject
.ropeproject
.ipynb_checkpoints/
.history/

# ---------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?
__MACOSX/

# Linux
.directory
.Trash-*
.fuse_hidden*

# ---------------------------------------------------------------------
# Archives (uncomment if you keep release zips in the repo)
# ---------------------------------------------------------------------
# *.zip
# *.7z
# *.tar.gz
